{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyncost",
  "version": "../package.json",
  "identifier": "com.lyncost.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lyncost — Personal Finance & Investments",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Offline, privacy-first personal finance & investment tracker",
    "longDescription": "Lyncost tracks accounts, transactions, budgets, goals, debts, investments, bills and warranties entirely offline. Your financial data stays in a local SQLite database on your computer and never leaves it.",
    "publisher": "Wintershogun TechLabs",
    "copyright": "© 2026 Wintershogun TechLabs",
    "homepage": "https://wintershogun.com/products/lyncost",
    "license": "LicenseRef-Proprietary",
    "linux": {
      "rpm": {
        "release": "1",
        "desktopTemplate": "../packaging/linux/lyncost.desktop.hbs",
        "files": {
          "/usr/share/metainfo/com.lyncost.desktop.metainfo.xml": "../packaging/linux/com.lyncost.desktop.metainfo.xml"
        }
      },
      "deb": {
        "section": "utils",
        "desktopTemplate": "../packaging/linux/lyncost.desktop.hbs",
        "files": {
          "/usr/share/metainfo/com.lyncost.desktop.metainfo.xml": "../packaging/linux/com.lyncost.desktop.metainfo.xml"
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
