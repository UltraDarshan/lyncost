{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyncost",
  "version": "0.1.9",
  "identifier": "com.lyncost.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lyncost — Personal Finance & Investments",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "100% Offline, Privacy-First Personal Finance & Investment Tracker",
    "publisher": "Wintershogun TechLabs",
    "copyright": "© 2026 Wintershogun TechLabs"
  }
}
